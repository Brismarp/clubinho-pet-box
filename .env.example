APP_ENV=local
APP_URL=http://localhost:8080

# Apache listen port (Docker maps 8080→80 locally; on Railway set PORT=8080)
PORT=80

DB_HOST=db
DB_PORT=3306
DB_NAME=clubinhopet
DB_USER=clubinho
DB_PASS=clubinho
DB_CHARSET=utf8mb4

# Payment: kirvano (redirect) | mock (in-app /assinatura?mock_checkout=1)
PAYMENT_GATEWAY=mock

# Shipment + notifier always mock in this build (INTEGRATIONS_MODE reserved for future providers)
INTEGRATIONS_MODE=mock

# Optional shared secret for POST /webhooks/kirvano (X-Kirvano-Secret or X-Webhook-Secret)
KIRVANO_WEBHOOK_SECRET=

